# PUBLIC client-side configuration ONLY. Every VITE_ value is embedded in browser JS.
# An omitted/unknown selector always gives the informational website, with no Auth/Storage calls.
# Do NOT rely on a Cloudflare preview domain, query parameter or a public key to activate booking.
# Profile A (default static output): npm run build
# Profile B (conditional, after owner approvals): npm run build:connected
# Profile B needs the public URL and publishable key provided only for this local build.
# The backend STILL must prove Auth/RLS, published service/resource/species, branch schedule and nonce.
# VITE_RELEASE_PROFILE=informational

# Nonsecret project URL, NOT a Postgres connection string; only used for explicit Profile B.
VITE_SUPABASE_URL=https://lgimhirgvresvbsdugac.supabase.co
# Supabase Dashboard > Project Settings > API Keys > publishable key (sb_publishable_...)
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never include service_role, sb_secret_, database passwords or private keys.
# All sensitive preview workspaces remain OFF. This two-track public build refuses ON flags.
# VITE_PHASE4_PATIENT_FORM=false
# VITE_PHASE5A_OPS_UI=false
# VITE_CLINICAL_WORKSPACE_UI=false
# VITE_PHASE5B_PHARMACY_UI=false
# VITE_PHASE5C_BILLING_UI=false
